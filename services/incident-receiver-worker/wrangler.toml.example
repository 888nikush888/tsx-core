# Copy to wrangler.toml only after an operator creates and names a D1 database.
name = "tsx-core-incident-receiver"
main = "worker.js"
compatibility_date = "2026-09-25"

[[d1_databases]]
binding = "DB"
database_name = "tsx-core-incidents"
database_id = "REPLACE_WITH_OPERATOR_CREATED_DATABASE_ID"

[triggers]
crons = ["0 3 * * *"]
