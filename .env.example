# OpenRouter API Configuration
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-flash-1.5
OPENROUTER_FALLBACK_MODEL=anthropic/claude-3-haiku

# Telegram API Configuration
# Get your credentials at https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=YOUR_API_HASH_HERE

# Dashboard control-plane authentication
# Generate at least 32 random bytes per token; never commit real values.
DASHBOARD_ADMIN_TOKEN=replace_with_at_least_32_random_bytes
# Optional read-only dashboard role. Leave empty to disable.
DASHBOARD_VIEWER_TOKEN=
# Binds locally by default. Put a TLS reverse proxy in front for remote access.
WEB_HOST=127.0.0.1
# Required only when a separate browser origin accesses the API.
# DASHBOARD_ALLOWED_ORIGIN=https://forwarder.example.com

# Observability Configuration
# JSON_LOGGING=true
# METRICS_PORT=9100
# METRICS_HOST=127.0.0.1
# PORT=8080
# Maximum wait for TDLib's send-success/send-failed confirmation (1-300 seconds).
# DELIVERY_CONFIRM_TIMEOUT_MS=30000
# Zeit für das tatsächliche Beenden laufender Queue-Jobs bei SIGTERM/SIGINT (1-120 Sekunden).
# SHUTDOWN_GRACE_MS=30000

# Verifizierte Online-Backups: maximal 15 Minuten für das zugesagte RPO.
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_MS=900000
# BACKUP_RETENTION_COUNT=672
