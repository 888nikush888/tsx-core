# Standard Docker ignores .env completely: configure credentials, keys and runtime/enterprise settings in the web dashboard.
CLOCK_MAX_DRIFT_MS=1000
# These variables remain reference material for source-only development or an explicit custom orchestrator override.
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
OPENROUTER_MODEL=google/gemini-flash-1.5
OPENROUTER_FALLBACK_MODEL=anthropic/claude-3-haiku

# Telegram API Configuration
# Get your credentials at https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_API_HASH_FILE=/run/secrets/telegram_api_hash

# Dashboard control-plane authentication
# Generate at least 32 random bytes per token; never commit real values.
# DASHBOARD_ADMIN_TOKEN=
# DASHBOARD_ADMIN_TOKEN_FILE=/run/secrets/dashboard_admin_token
# Optional read-only dashboard role. Leave empty to disable.
DASHBOARD_VIEWER_TOKEN=
# DASHBOARD_VIEWER_TOKEN_FILE=/run/secrets/dashboard_viewer_token
# Standalone Docker defaults to one-time web token bootstrap. ENTERPRISE_MODE=true defaults to OIDC.
# ENTERPRISE_MODE=false
# DASHBOARD_AUTH_MODE=oidc
# DASHBOARD_OIDC_ISSUER=https://identity.example.com/realms/operations
# DASHBOARD_OIDC_AUDIENCE=tsx-core
# DASHBOARD_OIDC_JWKS_URL=https://identity.example.com/realms/operations/protocol/openid-connect/certs
# DASHBOARD_OIDC_ADMIN_ROLE=forwarder-admin
# DASHBOARD_OIDC_VIEWER_ROLE=forwarder-viewer
# DASHBOARD_OIDC_ROLE_CLAIM=roles
# DASHBOARD_OIDC_MAX_TOKEN_AGE_SECONDS=3600
# Tailnet-only remote access through Tailscale Serve (never Funnel):
# DASHBOARD_AUTH_MODE=tailscale
# TAILSCALE_SERVE_TRUSTED_PROXY=true
# DASHBOARD_LOCAL_TRUST=false
# DASHBOARD_ALLOWED_ORIGIN=https://your-device.your-tailnet.ts.net
# TAILSCALE_ADMIN_USERS=operator@example.com
# TAILSCALE_VIEWER_USERS=observer@example.com
# Binds locally by default. Put a TLS reverse proxy in front for remote access.
WEB_HOST=127.0.0.1
# Required only when a separate browser origin accesses the API.
# DASHBOARD_ALLOWED_ORIGIN=https://forwarder.example.com
# Only the supplied loopback-only Docker Compose profile enables this break-glass
# recovery session. Never set it for a remotely published dashboard.
# DASHBOARD_RECOVERY_LOCAL_TRUST=true

# Observability Configuration
# JSON_LOGGING=true
# METRICS_PORT=9100
# METRICS_HOST=127.0.0.1
# PORT=8080
# Docker Compose publishes the fixed internal ports only on host loopback.
# HOST_WEB_PORT=8080
# HOST_METRICS_PORT=9100
# The independent MCP service starts with the normal stack. Its factory-default
# runtime mode is disabled; activate it or select standby in Dashboard > MCP-Agenten.
# Agent tokens and permanent permissions are created in Dashboard > MCP-Agenten.
# The published port remains host-loopback-only; use Tailscale Serve, never Funnel.
# HOST_MCP_PORT=8091
# MCP_ENDPOINT_URL=http://127.0.0.1:8091/mcp
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp-server
# Browser-based MCP clients are rejected unless their exact origin is listed.
# MCP_ALLOWED_ORIGINS=
# MCP_RUNTIME_POLL_MS=500
# MCP_MEMORY_LIMIT=384m
# MCP_CPU_LIMIT=0.5
# Production must use the attested immutable digest from release-manifest.json.
# FORWARDER_IMAGE=ghcr.io/owner/repository@sha256:replace_with_release_digest
# FORWARDER_MEMORY_LIMIT=1g
# FORWARDER_CPU_LIMIT=1.0
# Incident URL and both relay tokens are configured in the Web UI. Environment/file variables remain custom-orchestrator overrides.
# ALERT_WEBHOOK_URL=https://incident-gateway.example/v1/alerts
# ALERT_RELAY_TOKEN_FILE=/run/secrets/alert_relay_token
# ALERT_WEBHOOK_TOKEN_FILE=/run/secrets/alert_webhook_token
# Immutable audit gateway. Required by the production container before any control-plane mutation.
# AUDIT_WEBHOOK_URL=https://audit-gateway.example/v1/records
# AUDIT_WEBHOOK_TOKEN_FILE=/run/secrets/audit_webhook_token
# AUDIT_WEBHOOK_TIMEOUT_MS=10000
# AUDIT_LOCAL_MAX_BYTES=67108864
# HOST_PROMETHEUS_PORT=9090
# HOST_ALERTMANAGER_PORT=9093
# Read-only production-observer access used by the 30-day evidence gate.
# PROMETHEUS_URL=https://prometheus.example.com
# PROMETHEUS_TOKEN_FILE=/run/secrets/prometheus_token
# Maximum wait for TDLib's send-success/send-failed confirmation (1-300 seconds).
# DELIVERY_CONFIRM_TIMEOUT_MS=30000
# Zeit für das tatsächliche Beenden laufender Queue-Jobs bei SIGTERM/SIGINT (1-120 Sekunden).
# SHUTDOWN_GRACE_MS=30000

# Verifizierte Online-Backups: maximal 15 Minuten für das zugesagte RPO.
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_MS=900000
# BACKUP_RETENTION_COUNT=672
# ENTERPRISE_MODE=true requires off-host replication and rejects false.
# BACKUP_OFFSITE_REQUIRED=true
# HTTPS object endpoint supporting authenticated PUT and GET; {artifact} is replaced safely.
# BACKUP_OFFSITE_URL_TEMPLATE=https://backup-gateway.example/tsx-core/{artifact}
# BACKUP_OFFSITE_TOKEN_FILE=/run/secrets/backup_offsite_token
# Base64-encoded 32-byte AES key from an independent secret store.
# BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key
# BACKUP_OFFSITE_TIMEOUT_MS=60000
# Maximum encrypted off-site object accepted for one recovery (1 MiB - 8 GiB).
# BACKUP_OFFSITE_MAX_RECOVERY_BYTES=2147483648
# Set 0 to disable gateway retention receipts outside enterprise mode; enterprise requires at least 30.
# BACKUP_OFFSITE_RETENTION_DAYS=30
# DATA_RETENTION_DAYS=90
# DATA_RETENTION_INTERVAL_MS=21600000
# DATA_RETENTION_BATCH_SIZE=1000
# DATA_MIN_FREE_BYTES=1073741824

# Dedicated, already authenticated staging account and chats. Never reuse production TDLib state.
# E2E_SOURCE_CHAT_ID=-1000000000001
# E2E_TARGET_CHAT_ID=-1000000000002
# E2E_TDL_DATABASE_DIR=C:/forwarder-staging/session_data
# E2E_TDL_FILES_DIR=C:/forwarder-staging/session_files
# E2E_TIMEOUT_MS=300000
# E2E_SETTLE_MS=15000
