{
  "name": "telegram-tdlib-forwarder",
  "version": "1.0.0",
  "description": "Telegram Channel Forwarder using TDLib",
  "type": "module",
  "main": "dist/forwarder.js",
  "scripts": {
    "build": "tsc && npm run build --prefix frontend",
    "start": "node dist/forwarder.js",
    "dev": "tsx src/forwarder.ts",
    "test:js": "node tests/run_all.js",
    "test:ai-eval": "tsx tests/evaluate_signal_golden_set.js",
    "test:staging-e2e": "node scripts/run_staging_e2e.js",
    "backup:create": "tsx src/backup_cli.ts create",
    "backup:verify": "tsx src/backup_cli.ts verify",
    "backup:restore": "tsx src/backup_cli.ts restore",
    "ops:test-alert": "node scripts/send_synthetic_alert.js",
    "ops:soak": "node --import tsx scripts/check_soak_window.js",
    "test": "node tests/run_all.js",
    "test:coverage": "c8 node tests/run_all.js",
    "test:mutation": "node scripts/run_mutation_shards.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.js\" --quiet",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:report": "eslint \"src/**/*.ts\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.js\"",
    "typecheck": "tsc --noEmit",
    "quality:duplicates": "jscpd src --min-lines 5 --min-tokens 50 --threshold 5 --reporters console,json --output reports/jscpd",
    "quality:architecture": "node scripts/check_architecture.js",
    "quality:complexity": "node scripts/check_complexity_budget.js",
    "quality:frontend": "node scripts/check_frontend_reachability.js",
    "quality:release": "node scripts/check_release_artifacts.js",
    "quality:risk-acceptances": "node scripts/check_risk_acceptances.js",
    "quality:licenses": "node scripts/check_licenses.js",
    "quality:sbom": "node scripts/generate_sbom.js",
    "quality:monitoring": "node scripts/check_monitoring.js"
  },
  "keywords": [
    "telegram",
    "tdlib",
    "forwarder",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "qs": "6.15.3"
  },
  "dependencies": {
    "openai": "^6.46.0",
    "prebuilt-tdlib": "^0.1008064.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tdl": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^26.1.1",
    "c8": "^11.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jscpd": "^5.0.12",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "c8": {
    "all": true,
    "include": [
      "src/backup.ts",
      "src/crash_guard.ts",
      "src/delivery_tracker.ts",
      "src/queue.ts",
      "src/signal_schema.ts",
      "src/slo_tracker.ts",
      "src/tdlib_retry.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "text",
      "json-summary",
      "html"
    ],
    "reports-dir": "coverage",
    "check-coverage": true,
    "per-file": true,
    "branches": 80,
    "functions": 80,
    "lines": 80,
    "statements": 80
  }
}
