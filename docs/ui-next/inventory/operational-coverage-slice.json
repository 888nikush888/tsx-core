{
  "schemaVersion": 1,
  "scope": "Audited static slices of parameters.json: managed runtime, account identity/state, Telegram Viewer settings, deployment evidence, and the mandatory protective-stop gate. Other parameter families remain unaudited here.",
  "classes": ["runtime-editable", "create-only", "read-only-evidence", "host-bootstrap", "immutable-gate"],
  "groups": [
    {
      "id": "managed-runtime",
      "class": "runtime-editable",
      "paths": [
        "runtime.enterpriseMode", "runtime.dashboardAuthMode", "runtime.dashboardLocalTrust", "runtime.dashboardAllowedOrigin",
        "runtime.tailscaleServeTrustedProxy", "runtime.tailscaleAdminUsers", "runtime.tailscaleViewerUsers",
        "runtime.oidcIssuer", "runtime.oidcAudience", "runtime.oidcJwksUrl", "runtime.oidcAdminRole",
        "runtime.oidcViewerRole", "runtime.oidcRoleClaim", "runtime.oidcMaxTokenAgeSeconds",
        "runtime.auditWebhookUrl", "runtime.alertWebhookUrl", "runtime.auditRemoteRequired",
        "runtime.auditWebhookTimeoutMs", "runtime.alertWebhookTimeoutMs", "runtime.auditLocalMaxBytes",
        "runtime.backupOffsiteRequired", "runtime.backupOffsiteUrlTemplate", "runtime.backupOffsiteTimeoutMs",
        "runtime.backupOffsiteMaxRecoveryBytes", "runtime.backupOffsiteRetentionDays", "runtime.backupIntervalMs",
        "runtime.backupRetentionCount", "runtime.dataRetentionDays", "runtime.dataRetentionIntervalMs",
        "runtime.dataRetentionBatchSize", "runtime.dataMinFreeBytes", "runtime.deliveryConfirmTimeoutMs",
        "runtime.shutdownGraceMs", "runtime.clockMaxDriftMs", "runtime.jsonLogging", "runtime.isolateUnavailableMarketFailures"
      ],
      "uiRoute": "/operations/settings",
      "uiControl": "frontend/src/features/operations/runtime-parameters.tsx",
      "mutationRoute": "POST /api/runtime-settings",
      "backendValidator": "src/runtime_settings.ts",
      "auditAction": "runtime.settings.update",
      "contractTest": "tests/test_runtime_settings.js",
      "effect": "Saved while running; effective at restart, except immediate session revocation for access changes."
    },
    {
      "id": "account-creation",
      "class": "create-only",
      "paths": ["account.name", "account.exchange", "account.mode"],
      "uiRoute": "/trading/accounts",
      "uiControl": "frontend/src/features/accounts/accounts.tsx",
      "mutationRoute": "POST /api/trading/accounts",
      "backendValidator": "src/trading_web_control.ts",
      "auditAction": "trading.accounts.post",
      "contractTest": "tests/test_trading_web_control.js",
      "effect": "Account identity is bound at creation; a different exchange or mode requires a separately verified account."
    },
    {
      "id": "account-enable",
      "class": "runtime-editable",
      "paths": ["account.enabled"],
      "uiRoute": "/trading/accounts",
      "uiControl": "frontend/src/features/accounts/accounts.tsx",
      "mutationRoute": "POST /api/trading/accounts/state",
      "backendValidator": "src/trading_web_control.ts",
      "auditAction": "trading.accounts.state.post",
      "contractTest": "tests/test_trading_web_control.js",
      "effect": "Protected account state command; enabling is still subject to server-side admission gates."
    },
    {
      "id": "account-position-limit",
      "class": "runtime-editable",
      "paths": ["account.maxConcurrentPositions"],
      "uiRoute": "/trading/accounts",
      "uiControl": "frontend/src/features/accounts/account-position-limit.tsx",
      "mutationRoute": "POST /api/trading/accounts/configuration",
      "backendValidator": "src/trading_web_control.ts",
      "auditAction": "trading.accounts.configuration.post",
      "contractTest": "tests/test_trading_web_control.js",
      "effect": "Version-bound account limit, effective for new capacity reservations."
    },
    {
      "id": "account-observation",
      "class": "read-only-evidence",
      "paths": ["account.stateVersion", "account.status", "account.killSwitchActive", "account.credentialGeneration", "account.lastVerifiedAt"],
      "uiRoute": "/trading/accounts",
      "uiControl": "frontend/src/features/accounts/account-detail.tsx",
      "effect": "Observed state; kill-switch release and credential rotation are separate guarded commands, not direct field edits."
    },
    {
      "id": "telegram-viewer-settings",
      "class": "runtime-editable",
      "paths": [
        "viewer.enabled", "viewer.allowedUserIds", "viewer.timezone", "viewer.locale", "viewer.eventPollingIntervalMs",
        "viewer.notifications.positionOpened", "viewer.notifications.takeProfitFilled", "viewer.notifications.stopLossFilled",
        "viewer.notifications.positionClosed", "viewer.notifications.executionFailed", "viewer.notifications.accountIncidentOpened",
        "viewer.notifications.accountIncidentResolved", "viewer.notifications.exchangeStreamDegraded",
        "viewer.notifications.exchangeStreamRecovered", "viewer.notifications.killSwitchActivated",
        "viewer.notifications.signalReceived", "viewer.notifications.signalValidated", "viewer.notifications.intentCreated",
        "viewer.notifications.exchangeAcknowledged", "viewer.display.detailLevel", "viewer.display.pnlMode"
      ],
      "uiRoute": "/integrations/telegram-viewer",
      "uiControl": "frontend/src/features/telegram-viewer/telegram-viewer.tsx",
      "mutationRoute": "POST /api/telegram-viewer/settings",
      "backendValidator": "src/telegram_viewer_settings.ts",
      "auditAction": "telegram-viewer.settings.update",
      "contractTest": "tests/test_telegram_viewer_api.js",
      "effect": "A revision-bound admin update replaces the complete validated viewer settings document; the separate viewer service observes the persisted settings. Bot and service tokens use separate write-only commands."
    },
    {
      "id": "telegram-viewer-fixed-time-format",
      "class": "read-only-evidence",
      "paths": ["viewer.display.timeFormat"],
      "uiRoute": "/integrations/telegram-viewer",
      "uiControl": "frontend/src/features/telegram-viewer/telegram-viewer.tsx",
      "backendValidator": "src/telegram_viewer_settings.ts",
      "effect": "The fixed 24h value is visible but has no editor; the validator rejects any other value."
    },
    {
      "id": "deployment-bootstrap",
      "class": "host-bootstrap",
      "paths": ["deployment.VITE_BASENAME", "deployment.VITE_GTM_ID", "deployment.hostPorts", "deployment.cpu", "deployment.memory", "deployment.imageDigest"],
      "uiRoute": "/operations/deployment",
      "uiControl": "frontend/src/features/operations/deployment.tsx",
      "gap": "host-maintenance-ui",
      "evidence": {
        "deployment.VITE_BASENAME": { "visibility": "build-value", "detail": "Browser displays effective basename, with / for an unset value." },
        "deployment.VITE_GTM_ID": { "visibility": "presence-only", "detail": "Browser displays only whether a GTM ID was configured; the value is not returned." },
        "deployment.hostPorts": { "visibility": "partial", "detail": "Internal listener and optional process declarations do not prove published host/Compose port bindings." },
        "deployment.cpu": { "visibility": "partial", "detail": "OS parallelism, visible cgroup-v2 root limit and optional process declaration do not prove effective host/container limits." },
        "deployment.memory": { "visibility": "partial", "detail": "OS total memory, visible cgroup-v2 root limit and optional process declaration do not prove effective host/container limits." },
        "deployment.imageDigest": { "visibility": "absent", "detail": "The current deployment UI does not show the running image digest." }
      },
      "effect": "Build/host-owned values are not editable in the Core UI. Visibility is partial or absent as detailed per field; a separately authorized maintenance and recovery plane is required for UI-managed changes."
    },
    {
      "id": "mandatory-protective-stop",
      "class": "immutable-gate",
      "paths": ["strategy.safety.requireProtectiveStop"],
      "backendValidator": "src/trading_strategy.ts",
      "effect": "Server rejects false; no UI override is allowed."
    }
  ]
}
